{
  "name": "hedera-oracle-receipts",
  "version": "1.0.0",
  "private": true,
  "license": "MIT",
  "engines": {
    "node": ">=22.14.0"
  },
  "workspaces": [
    "packages/core",
    "packages/nextjs",
    "packages/hardhat"
  ],
  "scripts": {
    "dev": "npm run dev -w @sh/nextjs",
    "start": "npm run start -w @sh/nextjs",
    "build": "npm run compile -w @sh/hardhat && npm run build -w @sh/nextjs",
    "lint": "eslint . && npm run typecheck -w @sh/nextjs",
    "test": "node --test packages/core/test/*.test.mjs && npm run test -w @sh/hardhat",
    "capture": "node scripts/capture.mjs",
    "anchor": "node --env-file=.env scripts/anchor.mjs --testnet",
    "verify": "node scripts/verify.mjs",
    "next:dev": "npm run dev -w @sh/nextjs",
    "format": "prettier --write ."
  },
  "overrides": {
    "@grpc/grpc-js": "1.14.5",
    "protobufjs": "8.8.0"
  },
  "devDependencies": {
    "@hashgraph/sdk": "2.81.0",
    "eslint": "9.39.1",
    "eslint-config-next": "16.3.8",
    "prettier": "3.9.9",
    "typescript": "5.9.3"
  }
}
